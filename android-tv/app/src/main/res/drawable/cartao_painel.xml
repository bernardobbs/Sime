<?xml version="1.0" encoding="utf-8"?>
<!-- Foco e seleção precisam ser óbvios de longe: a pessoa está a 3 metros. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E3A6E" />
            <stroke android:width="4dp" android:color="#4F7DFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#16324F" />
            <stroke android:width="3dp" android:color="#2E7D52" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1C1C28" />
            <stroke android:width="2dp" android:color="#2A2A3A" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
